<?xml version="1.0" encoding="UTF-8"?>
<!--
=============================================================================
pom.xml - LogAgent Maven配置
=============================================================================

【文件作用】
LogAgent是一个独立的Java应用，负责：
1. 监听日志文件变化
2. 读取新增的日志行
3. 发送到Dashboard Server

【设计决策】为什么LogAgent要独立运行？
1. 解耦：采集和处理分离
2. 灵活：可以部署在不同机器
3. 可扩展：可以同时监控多个文件
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.minidog</groupId>
    <artifactId>log-agent</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Mini-Datadog Log Agent</name>
    <description>日志采集代理</description>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- HTTP客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- JSON处理 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包为可执行JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.minidog.agent.LogAgent</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- 包含依赖的shade插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
